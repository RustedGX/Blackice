# Required: Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./blackice.db

# Portfolio settings
INITIAL_BALANCE=100000.0
MAX_POSITION_PCT=0.20
MAX_DRAWDOWN_THRESHOLD=0.15

# Rate limiting for Claude API calls during backtesting
CLAUDE_CALLS_PER_MINUTE=10

# Live price refresh interval (seconds)
PRICE_MONITOR_INTERVAL=15

# Slippage simulation
SLIPPAGE_PCT=0.0001

# Server
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
